RANKPILOT_ENVIRONMENT=development
RANKPILOT_DATABASE_URL=postgresql+psycopg2://rankpilot:rankpilot_dev@localhost:5432/rankpilot
RANKPILOT_REDIS_URL=redis://localhost:6379/0
RANKPILOT_JWT_SECRET=change-me-in-production
# Never commit real secrets here; set them as server-side environment secrets only.
RANKPILOT_OPENAI_API_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RANKPILOT_TOKEN_ENCRYPTION_KEY=
RANKPILOT_GOOGLE_CLIENT_ID=
RANKPILOT_GOOGLE_CLIENT_SECRET=
# Optional: unset means performance_score simply stays unmeasured, never a crash.
RANKPILOT_PAGESPEED_API_KEY=

# --- Paddle Billing (see docs/PADDLE_BILLING.md). Placeholders only: real values are set as server-side secrets. ---
# Which provider starts new checkouts: lemonsqueezy (default) or paddle.
RANKPILOT_BILLING_PROVIDER=lemonsqueezy
# sandbox or live. Sandbox and live have separate accounts, API keys, client tokens and webhook secrets.
RANKPILOT_PADDLE_ENV=sandbox
# Server-side only. Developer tools > Authentication > API keys.
RANKPILOT_PADDLE_API_KEY=
# Client-side token for Paddle.js (public by design). The web app also needs NEXT_PUBLIC_PADDLE_CLIENT_TOKEN and NEXT_PUBLIC_PADDLE_ENV.
RANKPILOT_PADDLE_CLIENT_TOKEN=
# Server-side only. Notification destination secret key (pdl_ntfset_...). Never exposed to the browser.
RANKPILOT_PADDLE_WEBHOOK_SECRET=
